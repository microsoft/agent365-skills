{
  "fields": [
    {
      "key": "traceId",
      "type": "Bytes",
      "description": "Unique identifier for a trace. All spans from the same trace share this ID. 16-byte array, hex-encoded to 32 chars.",
      "structural": true,
      "required": [[]]
    },
    {
      "key": "spanId",
      "type": "Bytes",
      "description": "Unique identifier for a span within a trace, assigned when the span is created. 8-byte array, hex-encoded to 16 chars by mappers.",
      "structural": true,
      "required": [[]]
    },
    {
      "key": "parentSpanId",
      "type": "Bytes",
      "description": "The span_id of this span's parent span. Empty for root spans. 8-byte array, hex-encoded by mappers.",
      "structural": true,
      "required": [[{ "field": "gen_ai.operation.name", "condition": "in", "values": ["execute_tool", "inference", "chat"] }], [{ "field": "gen_ai.operation.name", "condition": "in", "values": ["invoke_agent"] }, { "field": "microsoft.a365.caller.agent.id", "condition": "in", "values": ["*"], "legacy_names": ["gen_ai.caller.agent.id"] }]]
    },
    {
      "key": "name",
      "type": "String",
      "description": "A description of the span's operation. Used by some mappers for operation name resolution.",
      "structural": true
    },
    {
      "key": "kind",
      "type": "String",
      "description": "Span kind indicating the relationship type (Client, Server, Internal, Producer, Consumer).",
      "structural": true
    },
    {
      "key": "startTimeUnixNano",
      "type": "UInt64",
      "description": "Start time of the span in nanoseconds since Unix epoch. Converted to DateTime by mappers.",
      "structural": true,
      "required": [[{ "field": "gen_ai.operation.name", "condition": "not_in", "values": ["output_messages"] }]]
    },
    {
      "key": "endTimeUnixNano",
      "type": "UInt64",
      "description": "End time of the span in nanoseconds since Unix epoch. Converted to DateTime by mappers.",
      "structural": true,
      "required": [[{ "field": "request.ingestionSource", "condition": "not_in", "values": ["CopilotStudio"] }], [{ "field": "gen_ai.operation.name", "condition": "not_in", "values": ["invoke_agent", "inference"] }]]
    },
    {
      "key": "status",
      "type": "Object",
      "description": "Final status of the span containing Code (Unset/Ok/Error) and optional Message. Mappers extract ErrorType and ErrorMessage from this.",
      "structural": true
    },
    {
      "key": "gen_ai.operation.name",
      "type": "String",
      "description": "Name of the operation being performed.",
      "examples": ["invoke_agent", "execute_tool", "inference", "chat", "output_messages"],
      "required": [[]]
    },
    {
      "key": "gen_ai.agent.id",
      "type": "String",
